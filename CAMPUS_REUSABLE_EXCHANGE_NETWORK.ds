	 			column = 1   
				width = medium
			)
			must have unique Register_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Campus_Location
			(
				type = picklist
				maxchar = 100
				values = {"Chennai","Kanchipuram","Tiruvallur","Chengalpattu","Coimbatore","KaniyaKumari","Thothukudi","Vellore","Ariyalur","Karikudi"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			User_Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Suspended","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Profile_Photo1
			(
    			type = image

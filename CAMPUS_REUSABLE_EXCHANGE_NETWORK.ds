			(
				type = picklist	
				values  = Item_Loans.ID
    			displayformat = [Loan_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_By1
			(
				type = picklist	
				displayname = "Reported_By"
				values  = Campus_Users.ID
    			displayformat = [" " + Full_Name.prefix + " " + Full_Name.first_name + " " + Full_Name.last_name + " " + Full_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Type
			(
				type = picklist
				maxchar = 100
				values = {"Repair","Cleaning","Inspection","Replacement"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Problem_Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Problem_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_To
			(
				type = picklist	
				values  = Campus_Users.ID
    			displayformat = [Register_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Report_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Target_Completion_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Maintenance_Status
			(
				type = picklist
				maxchar = 100
				values = {"Open","Assigned","In Progress","Completed","Closed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Cost
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resolution_Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sentiment
			(
				type = picklist
				displayname = "Maintenance_Recommendation"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = SentimentAnalysis
									basefield = Problem_Description
						)
			)
			Maintanance_Steps
			(
    			type = ar
				displayname = "Maintanance Steps"
				ar sets = {"Guide 1"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Reusable_Items
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Item_ID
			(
    			type = autonumber
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category_Name
			(
				type = picklist	
				values  = Item_Categories.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Borrower_Active_Loans
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Type
			(
				type = picklist
				maxchar = 100
				values = {"Individual Asset","Bulk Stock"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Condition_field
			(
				type = picklist
				displayname = "Condition"
				maxchar = 100
				values = {"New","Excellent","Good","Damaged"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Quantity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Available_Quantity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Location
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Storage_Details
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ownership_Type
			(
				type = picklist
				maxchar = 100
				values = {"College","Donated","Community"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Donor_User
			(
				type = picklist	
				values  = Campus_Users.ID
    			displayformat = [" " + Full_Name.prefix + " " + Full_Name.first_name + " " + Full_Name.last_name + " " + Full_Name.suffix]
				allow new entries
				[
					displayname = "N/A"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Acquired
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Duration_Days
			(
				type = number
				displayname = "Total Duration Days"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Estimated_Value
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Image
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			About_Item
			(
    			type = video
				displayname = "About Item"
    			duration=30
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Document
			(
    			type = upload file
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Item_QR_Code"
				value = "${Item_ID}${Item_Name}"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reuse_Status
			(
				type = picklist
				maxchar = 100
				values = {"Available","Reserved","Issued","Maintenance","Retired"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Condition_Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category_Prediction
			(
    			type = text
				displayname = "﻿AI_Category_Prediction"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = Prediction
									modelname = "AI_Category_Suggestion"
									supportingfield = {Available_Quantity,Total_Quantity}
						)
			)
			Keyword
			(
    			type = textarea
				displayname = "AI_Keywords"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = KeywordExtractor
									basefield = Item_Name
						)
			)
			Last_Inspection_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Added_By
			(
				type = picklist	
				values  = Campus_Users.ID
    			displayformat = [" " + Full_Name.prefix + " " + Full_Name.first_name + " " + Full_Name.last_name + " " + Full_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Invoices
			(
				type = picklist	
				datasource = zoho_invoice_invoices
    			displayformat = [total_amount]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Object_Detection
			(
    			type = textarea
				displayname = "Object Detection Verification"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = ObjectDetection
									basefield = Item_Image
						)
			)
			OCR
			(
    			type = textarea
				displayname = "ITEM DETAILS IN REPORT"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									basefield = Item_Document
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}

	}
	chats
	{
		chat Circular_Campus_Reuse_Assistant
		{
			display name = "Circular Campus Reuse Assistant"
			access level = read_write
			instructions
			(
				value = "Act as a smart campus reuse assistant for the Circular Campus platform. Your primary goal is to help students, faculty, staff, and managers manage reusable items to promote sustainability.\nCore Capabilities:\nAssist users in finding available reusable items based on category, condition, location, and requirements.\nGuide users through submitting borrowing requests (Item_Loans) and Reuse_Requests.\nHelp track return deadlines, check request statuses, and identify overdue items.\nRegister item donations (Item_Donations) and report damaged items via Maintenance_Requests.\nFor inventory managers: Identify low-stock/underused items, review pending requests, suggest alternatives for unavailable items, and provide inventory/sustainability summaries.\nRole-Based Access & Safety:\n- Strictly enforce role-based access. Students see only their own data; managers/admins see authorized management data.\n- NEVER expose private user information.\n- NEVER approve requests, issue items, change stock quantities, accept donations, or modify records without explicit user confirmation and required permissions.\n- If information is missing, ask a relevant follow-up question or explain the limitation. Do not invent answers.\nInteraction Style:\n- Use a friendly, professional, and simple-English conversational tone.\n- Focus on making campus reuse easier, improving inventory utilization, and supporting a sustainable community.\n- When AI predictions are available (e.g., categorizing items from descriptions), suggest them but always allow the user or manager to verify the results.\n- Explain borrowing and return procedures clearly when asked."
			)
			personalization
			(
				welcome message = "Welcome to the Circular Campus Smart Reusable Item Management System! I can help you find items, submit loans, track returns, register donations, and manage inventory. How can I assist you today?"
			)
			forms
			(
				Campus_Users
				Maintenance_Requests
				Reusable_Items
				Item_Loans
				Item_Categories
				Reuse_Requests
				Item_Returns
				Item_Donations
			)
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void cancelOrder(int requestID, string reason)
                 {
                 	// Find request using Request_ID
                 	req = Reuse_Requests[Request_ID == requestID];
                 	if(req.ID == null)
                 	{
                 		info "Request not found.";
                 		return;
                 	}
                 	// Check request status
                 	if(req.Request_Status == "Cancelled")
                 	{
                 		info "Request is already cancelled.";
                 		return;
                 	}
                 	if(req.Request_Status == "Approved" || req.Request_Status == "Completed")
                 	{
                 		info "This request cannot be cancelled.";
                 		return;
                 	}
                 	// Find the linked Campus_Users record
                 	userRecord = Campus_Users[ID == req.Full_Name];
                 	if(userRecord.ID == null)
                 	{
                 		info "Linked Campus User not found.";
                 		return;
                 	}
                 	// Get registered email
                 	userEmail = userRecord.College_Email;
                 	if(userEmail == null || userEmail == "")
                 	{
                 		info "User email address is missing.";
                 		return;
                 	}
                 	// Set cancellation reason
                 	if(reason == null || reason.trim() == "")
                 	{
                 		reason = "No reason provided";
                 	}
                 	// Update request status
                 	req.Request_Status="Cancelled";
                 	req.Approval_Notes="Cancelled: " + reason;
                 	// Send email to the selected user
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :userEmail
                 		subject :"Circular Campus - Reuse Request Cancelled"
                 		message :"Hello " + userRecord.Full_Name + ",\n\nYour reuse request has been cancelled successfully.\n\nRequest ID: " + req.Request_ID + "\nQuantity: " + req.Quantity_Requested + "\nReason: " + reason + "\nStatus: Cancelled\n\nThank you,\nCircular Campus Team"
                 	]
                 	info "Request cancelled successfully.";
                 	info "Email sent to: " + userEmail;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Validate_Reuse_Request as "Validate_Reuse_Request"
			{
				type =  form
				form = Reuse_Requests

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity_Requested == null || input.Quantity_Requested < 1)
										{
											alert "Requested quantity must be at least 1.";
											cancel submit;
										}
										if(input.Expected_Return_Date < input.Required_From)
										{
											alert "Expected return date cannot be before the required-from date.";
											cancel submit;
										}
						)
					}
				}

			}
			Notify_Manager_New_Reques as "Notify_Manager_New_Request"
			{
				type =  form
				form = Reuse_Requests

				record event = on add or edit

				on success
				{
					actions 
					{
						success message "Data added or updated successfully";
					}
				}

			}
			Maintenance_Approval_Request as "Maintenance_Approval_Request"
			{
				type =  form
				form = Maintenance_Requests

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"gowthamdevendran1406@gmail.com"
											subject :"New Maintenance Approval Request - Circular Campus"
											message :"A new maintenance request has been submitted in Circular Campus.\n\n" + "Maintenance ID: " + input.Maintenance_ID + "\n" + "Issue Type: " + input.Issue_Type + "\n" + "Priority: " + input.Priority + "\n" + "Status: " + input.Maintenance_Status + "\n\n" + "Please log in to Circular Campus and review the maintenance request."
										]
						)
					}
				}

			}
			Update_Rejected_Status as "Update_Rejected_Status"
			{
				type =  form
				form = Reuse_Requests

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Update the Request_Status field to "Rejected" when the approver rejects the request
										input.Request_Status = "Rejected";
										// Optionally, log the action or perform additional updates if needed
										info "Request status updated to Rejected for Request ID: " + input.Request_ID;
						)
					}
				}

			}
			Update_Approved_Status as "Update_Approved_Status"
			{
				type =  form
				form = Reuse_Requests

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Update the Request_Status field to "Approved" for the current record
										update Reuse_Requests[ID == input.ID]
										[
											Request_Status="Approved"
										];
						)
					}
				}

			}
			Approval_Request_Submission as "Approval_Request_Submission"
			{
				type =  form
				form = Reuse_Requests

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the Approver record from the lookup field
										approverRecord = Campus_Users[ID == input.Approver];
										// Check if approver exists and has an email
										if(approverRecord != null && !approverRecord.College_Email.isNull())
										{
											// Prepare email details
											requestID = input.Request_ID;
											itemName = input.Reusable_Items1.Item_Name;
											quantity = input.Quantity_Requested;
											requestDate = input.Request_Date;
											purpose = input.Purpose;
											// Send approval notification email to the approver
											sendmail
											[
												from :zoho.adminuserid
												to :approverRecord.College_Email
												subject :"Approval Required: Reuse Request #" + requestID
												message :"<p>Dear Approver,</p><p>A new reuse request has been submitted for your approval.</p><p><strong>Request Details:</strong></p><ul><li>Request ID: " + requestID + "</li><li>Item: " + itemName + "</li><li>Quantity: " + quantity + "</li><li>Request Date: " + requestDate + "</li><li>Purpose: " + purpose + "</li></ul><p>Please review and approve or reject this request in the system.</p><p>Thank you.</p>"
												content type :HTML
											]
											// Log the action
											info "Approval notification sent to " + approverRecord.College_Email + " for Request #" + requestID;
										}
										else
										{
											// Log error if approver is missing or has no email
											info "Error: Approver not found or has no email address for Request #" + input.Request_ID;
										}
						)
					}
				}

			}
		}

		schedule
		{
			DAILY_STOCK_DETAILS as "DAILY STOCK DETAILS"
			{
				type =  schedule
				start = "2026-10-20 00:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "gowthamdevendran1406@gmail.com"
							to : "gowthamdevendran1406@gmail.com"
							subject : "DAILY STOCK DETAILS"
							message : "<div>${zoho.adminuserid}<br></div>"
							attachments : view : Item_Categories_Report as PDF
						)
					}
				}
			}
			MONTHLY_LOAN_EMAIL_REPORT as "MONTHLY LOAN EMAIL REPORT"
			{
				type =  schedule
				start = "2026-11-01 00:00:00"
				frequency = monthly
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						previousMonthDate = zoho.currentdate.toStartOfMonth().addMonth(-1);
										reportMonth = previousMonthDate.toString("MMMM-yyyy");
										reportMonthNumber = previousMonthDate.getMonth();
										reportYear = previousMonthDate.getYear();
										totalLoans = 0;
										returnedLoans = 0;
										pendingLoans = 0;
										overdueLoans = 0;
										totalFines = 0.0;
										for each  loan in Item_Loans
										{
											if(loan.Issue_Date != null)
											{
												if(loan.Issue_Date.getMonth() == reportMonthNumber && loan.Issue_Date.getYear() == reportYear)
												{
													totalLoans = totalLoans + 1;
													if(loan.Loan_Status == "Returned")
													{
														returnedLoans = returnedLoans + 1;
													}
													else if(loan.Loan_Status == "Pending")
													{
														pendingLoans = pendingLoans + 1;
													}
													else if(loan.Loan_Status == "Overdue")
													{
														overdueLoans = overdueLoans + 1;
													}
													if(loan.Fine_Amount != null)
													{
														totalFines = totalFines + loan.Fine_Amount;
													}
												}
											}
										}
										emailMessage = "CIRCULAR CAMPUS - MONTHLY LOAN REPORT\n\n";
										emailMessage = emailMessage + "Report Month: " + reportMonth + "\n\n";
										emailMessage = emailMessage + "TOTAL LOAN DETAILS\n";
										emailMessage = emailMessage + "Total Loans: " + totalLoans + "\n";
										emailMessage = emailMessage + "Returned Loans: " + returnedLoans + "\n";
										emailMessage = emailMessage + "Pending Loans: " + pendingLoans + "\n";
										emailMessage = emailMessage + "Overdue Loans: " + overdueLoans + "\n";
										emailMessage = emailMessage + "Total Fine Amount: Rs. " + totalFines + "\n\n";
										emailMessage = emailMessage + "This is the automatically generated monthly report from Circular Campus.";
										sendmail
										[
											from :zoho.adminuserid
											to :"gowtham.d.2024.cse@rajalakshmi.edu.in"
											subject :"Circular Campus - Monthly Loan Report - " + reportMonth
											message :emailMessage
										]
										info "Monthly loan report email sent.";
										info emailMessage;
					)
					}
				}
			}
		}

		approval
		{
			Reuse_Request_Approval as "Reuse Request Approval"
			{
				type =  approval
				form = Reuse_Requests[Request_Status == "Pending"]
				display fields = [Request_ID,Full_Name,Reusable_Items1,Quantity_Requested,Request_Date,Required_From,Expected_Return_Date]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						on load
						(
							requestRecord = Reuse_Requests[ID == input.ID];
												if(requestRecord != null)
												{
													requestRecord.Request_Status="Approved";
													requestRecord.Approver=zoho.loginuser;
													requestRecord.Approval_Notes="Request approved by " + zoho.loginuser;
													info "Request approved successfully.";
												}
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						on load
						(
							requestRecord = Reuse_Requests[ID == input.ID];
												if(requestRecord != null)
												{
													requestRecord.Request_Status="Rejected";
													requestRecord.Approver=zoho.loginuser;
													requestRecord.Approval_Notes="Request rejected by " + zoho.loginuser;
													info "Request rejected successfully.";
												}
						)
						}
					}
				}
			}
		}


 application "CAMPUS REUSABLE EXCHANGE NETWORK"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Campus_Users
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			User_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Full_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			User_Name
			(
    			type = picklist
				displayname = "User Name"
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have College_Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone_Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Gender
			(
				type = radiobuttons
				maxchar = 100
				values = {"Male","Female","Transgender"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Role
			(
				type = picklist
				maxchar = 100
				values = {"Student","Faculty","Staff","Admin"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist
				maxchar = 100
				values = {"Computer Science Engineering","Artificial Intelligence & Data  Science","Artificial Intelligence & Machine Learning","Electronics & Communication Engineering","Electrical & Electronics Engineering","Mechanical Engineering"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_of_Study
			(
				type = picklist
				maxchar = 100
				values = {"1","2","3","4","N/A"}

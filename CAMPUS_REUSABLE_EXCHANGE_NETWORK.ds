	datasources
	{
		zoho_invoice_invoices
		{
			displayname = "Zoho Invoice Invoices"
			module = invoice
			system connection = zohoinvoice
			adjustment
			(
				type = decimal
				displayname = "Adjustment"
				source field name = "adjustment"
			)
			adjustment_description
			(
				type = text
				displayname = "Adjustment Description"
				source field name = "adjustment_description"
			)
			allow_partial_payments

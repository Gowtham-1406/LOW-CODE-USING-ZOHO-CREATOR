		batchworkflow
		{
			MONTHLY_LOAN_DETAILS
			{
    			display name = "MONTHLY LOAN DETAILS"
    			type = batchworkflow
    			form = Item_Loans
    			event = "On Import"
    			batch size = 5
    			status = active
    			variables
    			(
        			Number totalLoans, Number returnedLoans, Number pendingLoans, Number overdueLoans, Decimal totalFines 
    			)
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											loanCount = 1;
										returnedCount = 0;
										pendingCount = 0;
										overdueCount = 0;
										fineAmount = 0.0;
										if(input.Loan_Status == "Returned")
										{
											returnedCount = 1;
										}
										else if(input.Loan_Status == "Pending")
										{
											pendingCount = 1;
										}
										else if(input.Loan_Status == "Overdue")
										{
											overdueCount = 1;
										}
										if(input.Fine_Amount != null)
										{
											fineAmount = input.Fine_Amount;
										}
										info "Monthly Loan Record Processed";
										info "Loan ID: " + input.ID;
										info "Total Loans: " + loanCount;
										info "Returned: " + returnedCount;
										info "Pending: " + pendingCount;
										info "Overdue: " + overdueCount;
										info "Fine: " + fineAmount;
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											currentMonth = zoho.currentdate.getMonth();
										currentYear = zoho.currentdate.getYear();
										monthlyPeriod = zoho.currentdate.toString("MMMM-yyyy");
										for each  loan in Item_Loans
										{
											if(loan.Issue_Date != null)
											{
												if(loan.Issue_Date.getMonth() == currentMonth && loan.Issue_Date.getYear() == currentYear)
												{
													monthlyStatus = "Completed";
													if(loan.Loan_Status == "Overdue")
													{
														monthlyStatus = "Overdue";
													}
													else if(loan.Loan_Status == "Pending")
													{
														monthlyStatus = "Pending";
													}
													else if(loan.Loan_Status == "Issued")
													{
														monthlyStatus = "In Progress";
													}
													else if(loan.Loan_Status == "Returned")
													{
														monthlyStatus = "Completed";
													}
													update Item_Loans[ID == loan.ID]
													[
														Monthly_Status=monthlyStatus
														Monthly_Period=monthlyPeriod
													];
												}
											}
										}
										info "Monthly loan processing completed.";
						)
					}
    			}
    			on failure 
    			{
					actions 
					{
						custom deluge script
						(
											info "MONTHLY LOAN DETAILS batch execution failed.";
										info "Please check the imported loan records and workflow execution details.";
						)
					}
    			}
			}
		}

	}
